---
layout: layouts/base.njk
permalink: /
---
{%- import "macros.njk" as m -%}
{%- set posts = collections.posts -%}
{%- set lead = posts[0] -%}

<section class="hero wrap">
  <h1 class="hero__logo"><img src="/assets/img/logo.png" alt="{{ site.title }}" width="1600" height="800"></h1>
  <div class="hero__notes mono">
    <p>{{ site.description }}</p>
    <p>{% if lead %}Latest &mdash; <a href="{{ lead.url }}">{{ lead.data.title }}</a>{% endif %}</p>
    <p>{% for c in columns %}<a class="is-special" href="/{{ c.slug }}/">{{ c.title }} &rarr;</a><br>{% endfor %}<a href="/articles/">All articles &rarr;</a></p>
  </div>
</section>

{% if lead %}
{%- set leadCol = columns | findColumn(lead.data.column) if lead.data.column -%}
<section class="lead wrap" aria-labelledby="lead-title">
  <p class="section-label mono"><span>Latest</span><span>{{ lead.date | readableDate }}</span></p>
  <a class="lead__link" href="{{ lead.url }}">
    <div class="lead__text">
      <p class="mono{% if leadCol %} is-special{% endif %}">{{ leadCol.title if leadCol else "Article" }}</p>
      <h2 class="lead__title" id="lead-title">{{ lead.data.title }}</h2>
      {% if lead.data.description %}<p class="lead__deck">{{ lead.data.description }}</p>{% endif %}
      <p class="mono lead__more">By {{ lead.data.author }} &nbsp;/&nbsp; Read &rarr;</p>
    </div>
    {{ m.cover(lead, true) }}
  </a>
</section>
{% endif %}

{# One dark band per special column (see src/_data/columns.json) #}
{% for c in columns %}
{%- set colPosts = posts | inColumn(c.slug) | limit(3) -%}
<section class="band" aria-labelledby="col-{{ c.slug }}">
  <div class="wrap">
    <p class="section-label mono"><span>{{ c.label or "Column" }}</span><span>{{ loop.index | pad }}</span></p>
    <div class="band__head">
      <h2 class="band__title" id="col-{{ c.slug }}">{{ c.title }}</h2>
      <div>
        <p class="band__deck">{{ c.description }}</p>
        <a class="btn btn--red" href="/{{ c.slug }}/">All {{ c.title | lower }} &rarr;</a>
      </div>
    </div>
    {% if colPosts.length %}
    <div class="cards">
      {%- for post in colPosts %}{{ m.card(post, columns) }}{% endfor %}
    </div>
    {% endif %}
  </div>
</section>
{% endfor %}

{% if posts.length > 1 %}
<section class="wrap" aria-labelledby="index-title">
  <p class="section-label mono"><span id="index-title">Recent</span><a href="/articles/">View all &rarr;</a></p>
  <ol class="rows">
    {%- for post in posts | skip(1) | limit(6) %}
    {{ m.row(post, loop.index + 1, columns) }}
    {%- endfor %}
  </ol>
</section>
{% endif %}

{% if videos.length %}
<section class="wrap" aria-labelledby="videos-title">
  <p class="section-label mono"><span id="videos-title">Videos</span><a href="/videos/">Watch all &rarr;</a></p>
  <div class="cards cards--videos">
    {%- for v in videos | limit(3) %}{% include "video.njk" %}{% endfor %}
  </div>
</section>
{% endif %}
