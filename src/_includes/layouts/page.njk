---
layout: layouts/base.njk
---
<section class="page-head{% if tone %} page-head--band tone-{{ tone }}{% endif %}">
  <div class="wrap">
    <p class="section-label mono"><span>{{ label or title }}</span><span>{{ site.title }}</span></p>
    <h1 class="page-title">{{ title }}</h1>
    <div class="wave" aria-hidden="true">{{ title | wave | safe }}</div>
  </div>
</section>
<div class="prose prose--page wrap">
{{ content | safe }}
</div>
