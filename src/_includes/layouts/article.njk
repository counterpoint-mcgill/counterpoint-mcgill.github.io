---
layout: layouts/base.njk
---
{%- import "macros.njk" as m -%}
{%- set col = columns | findColumn(column) if column -%}
{%- set idx = -1 -%}
{%- for p in collections.posts -%}{%- if p.url == page.url -%}{%- set idx = loop.index0 -%}{%- endif -%}{%- endfor -%}
{%- set newer = collections.posts[idx - 1] if idx > 0 -%}
{%- set older = collections.posts[idx + 1] -%}
<article class="article{% if col %} article--{{ col.slug }}{% endif %}">
  <header class="article__head wrap">
    <p class="mono article__crumb">
      <a href="{{ ('/' + col.slug + '/') if col else '/articles/' }}">&larr; {{ col.title if col else "Articles" }}</a>
    </p>
    <h1 class="article__title">{{ title }}</h1>
    {% if description %}<p class="article__deck">{{ description }}</p>{% endif %}
    <dl class="meta">
      <div><dt>By</dt><dd>{{ author }}</dd></div>
      <div><dt>Date</dt><dd><time datetime="{{ page.date | isoDate }}">{{ page.date | readableDate }}</time></dd></div>
      <div><dt>Filed</dt><dd{% if col %} class="is-special"{% endif %}>{{ col.title if col else "Article" }}</dd></div>
      <div><dt>Length</dt><dd>{{ content | readingTime }}</dd></div>
    </dl>
  </header>

  <figure class="article__cover wrap">
    <span class="cover-wrap"><img class="cover" src="{{ image or ('/assets/covers/' + page.fileSlug + '.svg') }}" alt="{{ imageAlt or '' }}" width="1600" height="900"></span>
    {% if imageCredit %}<figcaption class="mono">{{ imageCredit }}</figcaption>{% endif %}
  </figure>

  <div class="prose wrap">
{{ content | safe }}
  </div>

  <footer class="article__foot wrap">
    <button class="btn" type="button" data-copy-link>Copy link</button>
    <nav class="pager mono" aria-label="More articles">
      {% if older %}<a class="pager__prev" href="{{ older.url }}" data-scene="{{ older.data.title }}"><span>&larr; Previous</span><strong>{{ older.data.title }}</strong></a>{% else %}<span></span>{% endif %}
      {% if newer %}<a class="pager__next" href="{{ newer.url }}" data-scene="{{ newer.data.title }}"><span>Next &rarr;</span><strong>{{ newer.data.title }}</strong></a>{% endif %}
    </nav>
  </footer>
</article>
